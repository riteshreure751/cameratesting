def tree(path, depth=0):
    out = []
    try:
        names = [n for n in os.listdir(path) if not n.startswith(".") and n != "__pycache__"]
    except OSError:
        return out
    names.sort(key=lambda n: (not os.path.isdir(os.path.join(path, n)), n.lower()))
    for n in names[:80]:
        fp = os.path.join(path, n)
        rel = os.path.relpath(fp, ROOT)
        if os.path.isdir(fp):
            out.append({"name": n, "path": rel, "type": "dir", "children": tree(fp, depth + 1) if depth < 6 else []})
        else:
            out.append({"name": n, "path": rel, "type": "file"})
    if len(names) > 80:
        out.append({"name": "... %d more" % (len(names) - 80), "type": "more"})
    return out


