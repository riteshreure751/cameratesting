def sval(d, maxage=0.6):
    return d["cm"] if (d["cm"] is not None and time.time() - d["t"] < maxage) else None


def lidar_thread(ser):
    buf = bytearray()
    while True:
        try:
            buf += ser.read(max(ser.in_waiting, 9))
        except Exception:
            time.sleep(0.2)
            continue
        while len(buf) >= 9:
            if buf[0] == 0x59 and buf[1] == 0x59 and (sum(buf[:8]) & 0xFF) == buf[8]:
                dist = buf[2] | (buf[3] << 8)
                st = buf[4] | (buf[5] << 8)
                tmp = (buf[6] | (buf[7] << 8)) / 8.0 - 256
                if dist > 0 and 100 <= st < 65535:
                    LD.update(cm=round(dist - LIDAR_OFFSET_CM, 1), strength=st, temp=round(tmp, 1), t=time.time())
                else:
                    LD["cm"] = None
                del buf[:9]
            else:
                del buf[0]


def ultra_thread(sensor):
    while True:
        try:
            d = sensor.distance * 100.0
            if d < 199:
                US.update(cm=round(d - US_OFFSET_CM, 1), t=time.time())
            else:
                US["cm"] = None
        except Exception:
            US["cm"] = None
        time.sleep(0.05)


def sim_thread():
    t0 = time.time()
    while True:
        base = 70 + 65 * math.sin((time.time() - t0) / 6.0)
        if SIM_L:
            LD.update(cm=round(max(base + random.uniform(-.4, .4), 3), 1), strength=800, temp=30.0, t=time.time())
        if SIM_U:
            US.update(cm=round(max(base + 2.5 + random.uniform(-.6, .6), 3), 1), t=time.time())
        time.sleep(0.05)


def start_sensors():
    global SIM_L, SIM_U
    ser = None
    if serial:
        try:
            ser = serial.Serial(LIDAR_PORT, LIDAR_BAUD, timeout=0.05)
        except Exception as e:
            print("[LiDAR] cannot open %s: %s" % (LIDAR_PORT, e))
    if ser:
        threading.Thread(target=lidar_thread, args=(ser,), daemon=True).start()
    else:
        SIM_L = True
    us = None
    if GPIO_OK:
        try:
            us = DistanceSensor(echo=US_ECHO, trigger=US_TRIG, max_distance=2.0, queue_len=3)
        except Exception as e:
            print("[Ultrasonic] cannot start: %s" % e)
    if us:
        threading.Thread(target=ultra_thread, args=(us,), daemon=True).start()
    else:
        SIM_U = True
    if SIM_L or SIM_U:
        print("[SIMULATION] some sensors are simulated (hardware not found)")
        threading.Thread(target=sim_thread, daemon=True).start()


