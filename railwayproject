    RUN["buf"].add("\n>>> %s%s\n" % ("DEBUG (pdb): " if j.get("debug") else "Run: ", os.path.relpath(p, ROOT)))
    RUN["p"] = subprocess.Popen(args, cwd=os.path.dirname(p), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, bufsize=0)
    threading.Thread(target=run_reader, args=(RUN["p"], RUN["buf"]), daemon=True).start()
