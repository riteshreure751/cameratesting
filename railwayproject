class Buf:
    """Append-only text buffer that clients poll with an offset."""
    def __init__(self):
        self.t, self.base, self.lock = "", 0, threading.Lock()
    def add(self, x):
        with self.lock:
            self.t += x
            if len(self.t) > 200000:
                cut = len(self.t) - 150000
                self.t, self.base = self.t[cut:], self.base + cut
    def get(self, since):
        with self.lock:
            since = max(since, self.base)
            return self.t[since - self.base:], self.base + len(self.t)


