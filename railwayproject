CHECK = {"snap": None, "id": 0, "hist": collections.deque(maxlen=8)}


@app.route("/api/check", methods=["GET", "POST"])
def api_check():
    """One-shot obstacle check: reads both sensors for ~1 s, then asks the camera."""
    if request.method == "GET":
        return jsonify(list(CHECK["hist"]))
    l, u = [], []
    for _ in range(12):
        a, b = sval(LD), sval(US)
        if a is not None:
            l.append(a)
        if b is not None:
            u.append(b)
        time.sleep(0.08)
    med = lambda x: round(float(np.median(x)), 1) if x else None
    lc, uc = med(l), med(u)
    vals = [v for v in (lc, uc) if v is not None]
    near = min(vals) if vals else None
    fr = camera.get_frame()
    cam_ok, label = (None, None)
    if fr is not None:
        cam_ok, label = detector.check(fr, use_baseline=True)
    cam_txt = {True: "object seen", False: "nothing seen", None: "no reference yet"}[cam_ok]
    hit = near is not None and near <= OBSTACLE_CM
    if hit and cam_ok:
        level, verdict = "danger", "OBSTACLE PRESENT - camera confirmed"
    elif hit:
        level, verdict = "danger", "OBSTACLE PRESENT - sensors only (camera %s)" % ("did not confirm" if cam_ok is False else "cannot judge yet")
    elif cam_ok:
        level, verdict = "warn", "CAMERA SEES AN OBJECT - sensors read %s" % ("%.1f cm (beyond %g cm)" % (near, OBSTACLE_CM) if near is not None else "no data")
    elif near is None:
        level, verdict = "error", "NO SENSOR DATA - cannot check the track"
    else:
        level, verdict = "ok", "TRACK CLEAR - nearest object %.1f cm" % near
    if fr is not None:
        img = cv2.resize(fr, (480, int(480 * fr.shape[0] / fr.shape[1])))
        cv2.putText(img, verdict[:34], (10, 28), cv2.FONT_HERSHEY_SIMPLEX, 0.7,
                    {"danger": (60, 60, 255), "warn": (0, 176, 255), "ok": (120, 230, 90)}.get(level, (200, 200, 200)), 2)
        CHECK["snap"], CHECK["id"] = cv2.imencode(".jpg", img, [cv2.IMWRITE_JPEG_QUALITY, 85])[1].tobytes(), CHECK["id"] + 1
    res = {"time": datetime.datetime.now().strftime("%H:%M:%S"), "level": level, "verdict": verdict, "lidar": lc, "ultra": uc,
           "nearest": near, "camera": cam_txt, "label": label if cam_ok else None, "snap_id": CHECK["id"]}
    CHECK["hist"].append(res)
    try:
        with open(os.path.join(ROOT, "logs", "obstacle_checks.log"), "a") as fh:
            fh.write(datetime.datetime.now().isoformat(timespec="seconds") + " " + json.dumps(res) + "\n")
    except Exception:
        pass
    return jsonify(res)


