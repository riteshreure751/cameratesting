OBS = {"state": "clear", "label": None, "distance": None, "nearest": None, "t0": 0.0, "snap": None, "snap_id": 0}


def set_snapshot(fr, dist):
    if fr is None:
        return
    img = cv2.resize(fr, (480, int(480 * fr.shape[0] / fr.shape[1])))
    if dist is not None:
        cv2.putText(img, "%.1f cm" % dist, (12, 34), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (60, 60, 255), 2)
    ok, enc = cv2.imencode(".jpg", img, [cv2.IMWRITE_JPEG_QUALITY, 85])
    OBS["snap"], OBS["snap_id"] = enc.tobytes(), OBS["snap_id"] + 1
    try:
        name = datetime.datetime.now().strftime("obstacle_%Y%m%d_%H%M%S.jpg")
        cv2.imwrite(os.path.join(ROOT, "detections", name), fr)
    except Exception:
        pass


def monitor():
    hits, clear_t, last_chk, last_note = 0, None, 0.0, 0.0
    while True:
        time.sleep(0.05)
        now = time.time()
        vals = [v for v in (sval(LD), sval(US)) if v is not None]
        near = min(vals) if vals else None
        OBS["nearest"] = near
        if OBS["state"] == "clear":
            hits = hits + 1 if (near is not None and near <= OBSTACLE_CM) else 0
            if near is not None and near > OBSTACLE_CM + 20 and now - last_note > 0.25:
                last_note = now
                fr = camera.get_frame()
                if fr is not None:
                    detector.note_clear(fr)
            if hits >= 2:
                OBS.update(state="verifying", t0=now, label=None, distance=near)
                set_snapshot(camera.get_frame(), near)
                clear_t = None
                if AUTO_BRAKE and train.running:
                    train.stop("Auto-brake: obstacle at %.1f cm" % near, braked=True)
        else:
            if near is not None:
                OBS["distance"] = near
            if OBS["state"] != "confirmed" and now - last_chk > 0.25:
                last_chk = now
                fr = camera.get_frame()
                if fr is not None:
                    ok, label = detector.check(fr)
                    if ok:
                        OBS.update(state="confirmed", label=label)
                        set_snapshot(fr, OBS["distance"])
                if OBS["state"] == "verifying" and now - OBS["t0"] > 1.5:
                    OBS["state"] = "sensor"
            if near is not None and near <= OBSTACLE_CM + CLEAR_MARGIN_CM:
                clear_t = None
            elif clear_t is None:
                clear_t = now
            elif now - clear_t > 1.0:
                OBS.update(state="clear", label=None)
                hits = 0


# ------------------------------ train / motor -------------------------------
class Train:
    def __init__(self):
        self.running, self.braked, self.reason = False, False, ""
        self.target, self.cur, self.t_start = DEFAULT_SPEED, 0, 0.0
        self.fwd, self.low, self.pwm = [], [], None
        if GPIO_OK and ON_PI:
            try:
                self.fwd = [DigitalOutputDevice(p) for p in MOTOR_FWD_PINS]
                self.low = [DigitalOutputDevice(p) for p in MOTOR_LOW_PINS]
                self.pwm = PWMOutputDevice(MOTOR_PWM_PIN, frequency=1000)
            except Exception as e:
                print("[Motor] cannot start: %s (motor simulated)" % e)
        threading.Thread(target=self.loop, daemon=True).start()

    def _apply(self, v):
        if not self.pwm:
            return
        for d in self.low:
            d.off()
        if v <= 0:
            for d in self.fwd:
                d.off()
            self.pwm.value = 0
        else:
            for d in self.fwd:
                d.on()
            self.pwm.value = min(1.0, v / 255.0)

    def start(self):
        if OBS["state"] != "clear":
            return False, "Obstacle ahead - clear the track first"
        self.braked, self.reason, self.running, self.t_start, self.cur = False, "", True, time.time(), 0
        return True, "started"

    def stop(self, reason="Stopped", braked=False):
        self.running, self.cur, self.braked, self.reason = False, 0, braked, reason
        self._apply(0)

    def ramping(self):
        return self.running and (time.time() - self.t_start < RAMP_SECONDS or self.cur != self.target)

    def loop(self):
        while True:
            if self.running:
                frac = min(1.0, (time.time() - self.t_start) / RAMP_SECONDS)
                want = self.target if self.target <= START_PWM else START_PWM + (self.target - START_PWM) * frac
                self.cur = int(round(self.cur + max(-6, min(6, want - self.cur))))
                self._apply(self.cur)
            time.sleep(0.05)


