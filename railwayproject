class Camera:
    def __init__(self):
        self.lock, self.jpg, self.frame, self.id, self.kind = threading.Lock(), None, None, 0, "none"
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        grab, cam = None, None
        if Picamera2:
            try:
                cam = Picamera2()
                cam.configure(cam.create_video_configuration(main={"size": (FRAME_W, FRAME_H), "format": "RGB888"}))
                cam.start()
                grab, self.kind = cam.capture_array, "Pi Camera"
            except Exception as e:
                print("[Camera] picamera2 failed: %s" % e)
        if grab is None:
            try:
                cap = cv2.VideoCapture(0)
                if cap.isOpened():
                    grab, self.kind = (lambda: cap.read()[1]), "USB/OpenCV"
            except Exception:
                pass
        while True:
            try:
                if grab:
                    fr = grab()
                else:
                    fr = np.zeros((FRAME_H, FRAME_W, 3), np.uint8) + 25
                    cv2.putText(fr, "NO CAMERA FOUND", (190, FRAME_H // 2), cv2.FONT_HERSHEY_SIMPLEX, 1.4, (80, 80, 255), 3)
                    time.sleep(0.1)
                if fr is None:
                    time.sleep(0.05)
                    continue
                if fr.ndim == 3 and fr.shape[2] == 4:
                    fr = fr[:, :, :3]
                ok, enc = cv2.imencode(".jpg", fr, [cv2.IMWRITE_JPEG_QUALITY, 70])
                with self.lock:
                    self.frame, self.jpg, self.id = fr, enc.tobytes(), self.id + 1
            except Exception as e:
                print("[Camera] error: %s" % e)
                time.sleep(0.5)

    def get_jpg(self):
        with self.lock:
            return self.jpg, self.id

    def get_frame(self):
        with self.lock:
            return None if self.frame is None else self.frame.copy()


CLASSES = ["background", "aeroplane", "bicycle", "bird", "boat", "bottle", "bus", "car", "cat", "chair", "cow",
           "diningtable", "dog", "horse", "motorbike", "person", "pottedplant", "sheep", "sofa", "train", "tvmonitor"]


class Detector:
    """Camera confirmation. Uses MobileNet-SSD if its files are in models/, else a frame-change fallback."""
    def __init__(self):
        self.net, self.hist, self.baseline = None, collections.deque(maxlen=8), None
        self.bpath = os.path.join(ROOT, "models", "clear_reference.jpg")
        pt = os.path.join(ROOT, "models", "MobileNetSSD_deploy.prototxt")
        cm = os.path.join(ROOT, "models", "MobileNetSSD_deploy.caffemodel")
        if os.path.exists(pt) and os.path.exists(cm):
            try:
                self.net = cv2.dnn.readNetFromCaffe(pt, cm)
                print("[Detector] MobileNet-SSD loaded")
            except Exception as e:
                print("[Detector] model load failed: %s" % e)
        img = cv2.imread(self.bpath) if os.path.exists(self.bpath) else None
        if img is not None:
            self.baseline = self.small(img)

    @staticmethod
    def small(f):
        return cv2.GaussianBlur(cv2.resize(cv2.cvtColor(f, cv2.COLOR_BGR2GRAY), (80, 60)), (5, 5), 0)

    def note_clear(self, f):
        self.hist.append((time.time(), self.small(f)))

    def set_baseline(self, f):
        cv2.imwrite(self.bpath, f)
        self.baseline = self.small(f)

    def check(self, f, use_baseline=False):
        """Returns (True/False/None, label). None = camera cannot judge (no model, no reference)."""
        if self.net is not None:
            blob = cv2.dnn.blobFromImage(cv2.resize(f, (300, 300)), 0.007843, (300, 300), 127.5)
            self.net.setInput(blob)
            det = self.net.forward()
            for i in range(det.shape[2]):
                conf, idx = float(det[0, 0, i, 2]), int(det[0, 0, i, 1])
                x1, y1, x2, y2 = det[0, 0, i, 3:7]
                if conf > 0.4 and 0 < idx < len(CLASSES) and 0.15 < (x1 + x2) / 2 < 0.85 and y2 > 0.4:
                    return True, CLASSES[idx]
        ref = None
        if use_baseline and self.baseline is not None:
            ref = self.baseline
        else:
            now = time.time()
            for t, sm in self.hist:
                if now - t >= 0.8:
                    ref = sm
        if ref is None:
            return (False if self.net is not None else None), None
        diff = float(np.mean(cv2.absdiff(self.small(f), ref)[12:60, 16:64]))
        return diff > DIFF_THRESH, "Object / obstacle"


