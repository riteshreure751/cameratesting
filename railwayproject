def tree(path, depth=0):
    out = []
    try:
        names = [n for n in os.listdir(path) if not n.startswith(".") and n != "__pycache__"]
    except OSError:
        return out
    names.sort(key=lambda n: (not os.path.isdir(os.path.join(path, n)), n.lower()))
    for n in names[:80]:
        fp = os.path.join(path, n)
        rel = os.path.relpath(fp, ROOT)
        if os.path.isdir(fp):
            out.append({"name": n, "path": rel, "type": "dir", "children": tree(fp, depth + 1) if depth < 6 else []})
        else:
            out.append({"name": n, "path": rel, "type": "file"})
    if len(names) > 80:
        out.append({"name": "... %d more" % (len(names) - 80), "type": "more"})
    return out


@app.route("/api/tree")
def api_tree():
    return jsonify(root=ROOT, children=tree(ROOT))


@app.route("/api/file", methods=["GET", "POST"])
def api_file():
    if request.method == "GET":
        p = safe(request.args.get("path"))
        if not os.path.isfile(p):
            return jsonify(error="File not found"), 404
        if os.path.getsize(p) > 1_000_000:
            return jsonify(error="File too large to edit"), 400
        try:
            return jsonify(content=open(p, encoding="utf-8").read())
        except UnicodeDecodeError:
            return jsonify(error="Binary file - cannot edit"), 400
    j = request.json or {}
    p = safe(j.get("path"))
    if os.path.isdir(p):
        return jsonify(error="That is a folder"), 400
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        f.write(j.get("content", ""))
    return jsonify(ok=True)


@app.route("/api/raw")
def api_raw():
    p = safe(request.args.get("path"))
    if not os.path.isfile(p):
        abort(404)
    return send_file(p)


@app.route("/api/create", methods=["POST"])
def api_create():
    j = request.json or {}
    p = safe(j.get("path"))
    if os.path.exists(p):
        return jsonify(error="Already exists"), 400
    if j.get("type") == "dir":
        os.makedirs(p)
    else:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        open(p, "w").close()
    return jsonify(ok=True)


@app.route("/api/train/<act>", methods=["POST"])
def api_train(act):
    j = request.json or {}
    if "speed" in j:
        train.target = max(0, min(255, int(j["speed"])))
    if act == "start":
        ok, msg = train.start()
        return jsonify(ok=ok, msg=msg)
    if act == "stop":
        train.stop("Stopped by user")
    return jsonify(ok=True)


@app.route("/api/run", methods=["POST"])
def api_run():
    j = request.json or {}
    p = safe(j.get("path"))
    if not os.path.isfile(p):
        return jsonify(error="Open a file first"), 400
    old = RUN["p"]
    if old and old.poll() is None:
        old.kill()
    args = [sys.executable, "-u"] + (["-m", "pdb"] if j.get("debug") else []) + [p]
    RUN["buf"].add("\n>>> %s%s\n" % ("DEBUG (pdb): " if j.get("debug") else "Run: ", os.path.relpath(p, ROOT)))
    RUN["p"] = subprocess.Popen(args, cwd=os.path.dirname(p), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, bufsize=0)
    threading.Thread(target=run_reader, args=(RUN["p"], RUN["buf"]), daemon=True).start()
    return jsonify(ok=True)


@app.route("/api/run/stop", methods=["POST"])
def api_run_stop():
    if RUN["p"] and RUN["p"].poll() is None:
        RUN["p"].kill()
    return jsonify(ok=True)


@app.route("/api/run/input", methods=["POST"])
def api_run_input():
    p = RUN["p"]
    if p and p.poll() is None:
        try:
            p.stdin.write(((request.json or {}).get("text", "") + "\n").encode())
            p.stdin.flush()
        except Exception:
            pass
    return jsonify(ok=True)


@app.route("/api/run/output")
def api_run_output():
    text, nxt = RUN["buf"].get(int(request.args.get("since", 0)))
    return jsonify(text=text, next=nxt, running=bool(RUN["p"] and RUN["p"].poll() is None))


@app.route("/api/term/output")
def api_term_output():
    term_ensure()
    text, nxt = TERM["buf"].get(int(request.args.get("since", 0)))
    return jsonify(text=text, next=nxt)


@app.route("/api/term/input", methods=["POST"])
def api_term_input():
    term_ensure()
    if TERM["fd"] is not None:
        os.write(TERM["fd"], (request.json or {}).get("data", "").encode())
    return jsonify(ok=True)


@app.route("/api/shutdown", methods=["POST"])
def api_shutdown():
    train.stop("Shutdown")
    if os.name != "posix":
        return jsonify(ok=False, error="Shutdown only works on the Raspberry Pi")
    threading.Timer(1.5, lambda: subprocess.Popen(["sudo", "shutdown", "-h", "now"])).start()
    return jsonify(ok=True)


